# Application
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://ss_bot:ss_bot@postgres:5432/ss_bot
REDIS_URL=redis://redis:6379/0
API_BASE_URL=http://api:8000
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOG_LEVEL=INFO
APP_SESSION_SECRET=
SESSION_TTL_MINUTES=480
TASK_DEADLINE_REMINDER_HOURS=24
ARCHIVE_RETENTION_DAYS=365
ARCHIVE_DELETE_WARNING_DAYS=30

# Telegram Bot — obtain a NEW token from BotFather; never commit it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/webhook
TELEGRAM_WEBHOOK_SECRET=
MINI_APP_URL=http://localhost:5173

# Telegram MTProto service account (a dedicated human Telegram account)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SERVICE_PHONE=
TELEGRAM_SERVICE_SESSION_PATH=/run/secrets/telegram-service.session

# Private S3-compatible object storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=ss_bot
S3_SECRET_KEY=change-me-in-production
S3_BUCKET=task-photos
S3_REGION=us-east-1
S3_PRESIGN_TTL_SECONDS=900

# Bootstrap only: comma-separated Telegram IDs that should become administrators.
BOOTSTRAP_ADMIN_TELEGRAM_IDS=
